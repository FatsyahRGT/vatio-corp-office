{
  "name": "kantor-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kantor AI - kantor isometrik 3D berisi tim AI untuk digital agency",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "context:sync": "node scripts/sync-context.js",
    "test": "node --test test/**/*.test.js",
    "start": "node server/index.js",
    "logs:rotate": "node sys-agents/rotate-logs.js",
    "status:memory": "node sys-agents/check-status.js"
  },
  "dependencies": {
    "dotenv": "latest",
    "express": "latest",
    "jszip": "^3.10.2",
    "pdf-parse": "^2.4.5",
    "three": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
