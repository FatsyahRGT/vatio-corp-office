# Salin jadi .env lalu isi. JANGAN commit file .env.

# ---- Konfigurasi 9Router Gateway ----
# Isi dengan Gateway API Key dari dashboard 9Router Anda:
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://localhost:20128/v1

# Nama combo atau model di 9Router (misal: BudakCorp)
MODEL_LEADER=9router:my-combo
MODEL_TEAM=9router:my-combo

# Kode proteksi pengunjung (kosongkan jika untuk pemakaian lokal)
ACCESS_CODE=

PORT=3001

# Pengaman Kuota
MAX_TOKENS=1500
RATE_PER_MINUTE=60
DAILY_MAX_REQUESTS=1000
